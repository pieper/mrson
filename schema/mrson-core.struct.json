{
  "$schema": "https://json-structure.org/meta/core/v0/#",
  "$id": "https://mrson.org/schema/core/v0",
  "$root": "#/definitions/Scene",
  "definitions": {

    "Vec3": { "type": "array", "items": { "type": "double" } },
    "RGBA": { "type": "array", "items": { "type": "double" } },
    "Matrix16": { "type": "array", "items": { "type": "double" } },

    "BlobRef": {
      "type": "object",
      "properties": {
        "hash": { "type": "string" },
        "dtype": { "type": "string" },
        "count": { "type": "int32" },
        "comps": { "type": "int32" },
        "size": { "type": "string" },
        "codec": { "type": "string" }
      },
      "required": ["hash"]
    },

    "ZarrDesc": {
      "type": "object",
      "comment": "Chunked array descriptor for a volume blob (render/zarr.ts). Chunks are content-addressed: `chunkHashes` maps grid coords \"k.j.i\" -> a content hash, and each chunk is fetched flat at <blobBase>/<hash>. (Legacy positional dir/dataset layout is still accepted by the loader.)",
      "properties": {
        "shape": { "type": "array", "items": { "type": "int32" } },
        "chunks": { "type": "array", "items": { "type": "int32" } },
        "chunkGrid": { "type": "array", "items": { "type": "int32" } },
        "dtype": { "type": "string" },
        "bytes": { "type": "string" },
        "chunkHashes": { "type": "map", "values": { "type": "string" } },
        "dir": { "type": "string" },
        "dataset": { "type": "string" }
      },
      "required": ["shape", "chunks", "chunkGrid", "dtype"]
    },

    "Refs":  { "type": "map", "values": { "type": "array", "items": { "type": "string" } } },
    "Attrs": { "type": "map", "values": { "type": "string" } },
    "Blobs": { "type": "map", "values": { "type": { "$ref": "#/definitions/BlobRef" } } },

    "Code": {
      "type": "object",
      "properties": {
        "scheme": { "type": "string" },
        "value": { "type": "string" },
        "meaning": { "type": "string" }
      },
      "required": ["scheme", "value"]
    },

    "Source": {
      "type": "object",
      "properties": {
        "mrmlClass": { "type": "string" },
        "producer": { "type": "string" },
        "producedAt": { "type": "datetime" },
        "derivedFrom": { "type": "array", "items": { "type": "string" } }
      }
    },

    "DicomBag": {
      "type": "object",
      "properties": {
        "sopClassUID": { "type": "string" },
        "seriesInstanceUID": { "type": "string" },
        "frameOfReferenceUID": { "type": "string" },
        "tags": { "type": "map", "values": { "type": "string" } }
      }
    },

    "Node": {
      "abstract": true,
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "frame": { "type": "string" },
        "refs": { "type": { "$ref": "#/definitions/Refs" } },
        "attrs": { "type": { "$ref": "#/definitions/Attrs" } },
        "blobs": { "type": { "$ref": "#/definitions/Blobs" } },
        "dicom": { "type": { "$ref": "#/definitions/DicomBag" } },
        "source": { "type": { "$ref": "#/definitions/Source" } }
      },
      "required": ["id"]
    },

    "DisplayableNode": {
      "abstract": true,
      "type": "object",
      "$extends": "#/definitions/Node",
      "comment": "A node shown via one or more SEPARATE `display` nodes, referenced through refs.display. Display properties (color, window/level, transfer function, representation) live on the display nodes, NOT here. MRML keeps display independent on purpose: one displayable node may have several display nodes, each optionally scoped to specific views (a 'display scenario' — e.g. a different transfer function for the same volume in different views). See DisplayNode."
    },

    "ImageNode": {
      "type": "object",
      "$extends": "#/definitions/DisplayableNode",
      "properties": {
        "dims": { "type": "array", "items": { "type": "int32" } },
        "ijkToRAS": { "type": { "$ref": "#/definitions/Matrix16" } },
        "voxelType": { "type": "string" },
        "comps": { "type": "int32" },
        "zarr": { "type": { "$ref": "#/definitions/ZarrDesc" } }
      },
      "required": ["dims", "ijkToRAS"]
    },

    "MeshNode": {
      "type": "object",
      "$extends": "#/definitions/DisplayableNode",
      "comment": "Mesh geometry lives in refs'd blobs; display via refs.display."
    },

    "Segment": {
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "color": { "type": { "$ref": "#/definitions/RGBA" } },
        "labelValue": { "type": "int32" },
        "terminology": { "type": { "$ref": "#/definitions/Code" } }
      },
      "required": ["id"]
    },

    "SegmentationNode": {
      "type": "object",
      "$extends": "#/definitions/DisplayableNode",
      "properties": {
        "segments": { "type": "array", "items": { "type": { "$ref": "#/definitions/Segment" } } },
        "referenceImage": { "type": "string" }
      },
      "required": ["segments"]
    },

    "ControlPoint": {
      "type": "object",
      "properties": {
        "label": { "type": "string" },
        "position": { "type": { "$ref": "#/definitions/Vec3" } },
        "selected": { "type": "boolean" }
      },
      "required": ["position"]
    },

    "MarkupNode": {
      "type": "object",
      "$extends": "#/definitions/DisplayableNode",
      "properties": {
        "markupType": { "type": "string", "enum": ["fiducial", "line", "angle", "curve", "closedcurve", "plane", "roi"] },
        "controlPoints": { "type": "array", "items": { "type": { "$ref": "#/definitions/ControlPoint" } } }
      },
      "required": ["markupType"]
    },

    "TransformNode": {
      "type": "object",
      "$extends": "#/definitions/Node",
      "properties": {
        "transformType": { "type": "string", "enum": ["linear", "bspline", "grid", "thinplate", "composite"] },
        "toParent": { "type": { "$ref": "#/definitions/Matrix16" } }
      },
      "required": ["transformType"]
    },

    "CameraNode": {
      "type": "object",
      "$extends": "#/definitions/Node",
      "properties": {
        "position": { "type": { "$ref": "#/definitions/Vec3" } },
        "focalPoint": { "type": { "$ref": "#/definitions/Vec3" } },
        "viewUp": { "type": { "$ref": "#/definitions/Vec3" } },
        "viewAngle": { "type": "double" },
        "parallelScale": { "type": "double" }
      },
      "required": ["position", "focalPoint", "viewUp"]
    },

    "ViewNode": {
      "type": "object",
      "$extends": "#/definitions/Node",
      "properties": {
        "kind": { "type": "string", "enum": ["3d", "slice"] },
        "layoutName": { "type": "string" },
        "orientation": { "type": "string" },
        "sliceToRAS": { "type": { "$ref": "#/definitions/Matrix16" } },
        "xyToRAS": { "type": { "$ref": "#/definitions/Matrix16" } },
        "dimensions": { "type": "array", "items": { "type": "int32" } },
        "fieldOfView": { "type": { "$ref": "#/definitions/Vec3" } }
      },
      "required": ["kind"]
    },

    "ColorStop": {
      "type": "object",
      "properties": {
        "value": { "type": "double" },
        "rgba": { "type": { "$ref": "#/definitions/RGBA" } }
      },
      "required": ["value", "rgba"]
    },

    "OpacityStop": {
      "type": "object",
      "properties": {
        "value": { "type": "double" },
        "opacity": { "type": "double" }
      },
      "required": ["value", "opacity"]
    },

    "TransferFunctionNode": {
      "type": "object",
      "$extends": "#/definitions/Node",
      "properties": {
        "colorStops": { "type": "array", "items": { "type": { "$ref": "#/definitions/ColorStop" } } },
        "scalarOpacity": { "type": "array", "items": { "type": { "$ref": "#/definitions/OpacityStop" } } },
        "gradientOpacity": { "type": "array", "items": { "type": { "$ref": "#/definitions/OpacityStop" } } },
        "shade": { "type": "boolean" }
      }
    },

    "DisplayNode": {
      "abstract": true,
      "type": "object",
      "$extends": "#/definitions/Node",
      "comment": "Display of a displayable node, kept independent on purpose. `viewRefs` = the view ids this display applies to; absent or empty means all views. A displayable node references one or more display nodes via refs.display, so the same object can be shown differently (e.g. a different transfer function) per view.",
      "properties": {
        "viewRefs": { "type": "array", "items": { "type": "string" } },
        "visible": { "type": "boolean" }
      }
    },

    "ScalarVolumeDisplayNode": {
      "type": "object",
      "$extends": "#/definitions/DisplayNode",
      "comment": "2D (slice) display of a scalar volume. refs.colorNode -> a color LUT if any.",
      "properties": {
        "window": { "type": "double" },
        "level": { "type": "double" },
        "color": { "type": { "$ref": "#/definitions/RGBA" } },
        "interpolate": { "type": "boolean" }
      }
    },

    "VolumeRenderingDisplayNode": {
      "type": "object",
      "$extends": "#/definitions/DisplayNode",
      "comment": "Volume-rendering display. refs.transferFunction -> the transferFunction node used in these views.",
      "properties": {
        "technique": { "type": "string" }
      }
    },

    "ModelDisplayNode": {
      "type": "object",
      "$extends": "#/definitions/DisplayNode",
      "properties": {
        "color": { "type": { "$ref": "#/definitions/RGBA" } },
        "opacity": { "type": "double" },
        "representation": { "type": "string", "enum": ["points", "wireframe", "surface"] },
        "edgeVisibility": { "type": "boolean" }
      }
    },

    "MarkupDisplayNode": {
      "type": "object",
      "$extends": "#/definitions/DisplayNode",
      "properties": {
        "color": { "type": { "$ref": "#/definitions/RGBA" } },
        "selectedColor": { "type": { "$ref": "#/definitions/RGBA" } },
        "glyphScale": { "type": "double" },
        "textScale": { "type": "double" }
      }
    },

    "AnyNode": {
      "type": "choice",
      "$extends": "#/definitions/Node",
      "selector": "type",
      "choices": {
        "image":            { "type": { "$ref": "#/definitions/ImageNode" } },
        "mesh":             { "type": { "$ref": "#/definitions/MeshNode" } },
        "segmentation":     { "type": { "$ref": "#/definitions/SegmentationNode" } },
        "markup":           { "type": { "$ref": "#/definitions/MarkupNode" } },
        "transform":        { "type": { "$ref": "#/definitions/TransformNode" } },
        "camera":           { "type": { "$ref": "#/definitions/CameraNode" } },
        "view":             { "type": { "$ref": "#/definitions/ViewNode" } },
        "transferFunction": { "type": { "$ref": "#/definitions/TransferFunctionNode" } },
        "scalarVolumeDisplay":    { "type": { "$ref": "#/definitions/ScalarVolumeDisplayNode" } },
        "volumeRenderingDisplay": { "type": { "$ref": "#/definitions/VolumeRenderingDisplayNode" } },
        "modelDisplay":           { "type": { "$ref": "#/definitions/ModelDisplayNode" } },
        "markupDisplay":          { "type": { "$ref": "#/definitions/MarkupDisplayNode" } }
      }
    },

    "Scene": {
      "type": "object",
      "properties": {
        "mrson": { "type": "int32" },
        "blobBase": { "type": "string" },
        "nodes": { "type": "map", "values": { "type": { "$ref": "#/definitions/AnyNode" } } }
      },
      "required": ["mrson", "nodes"]
    }
  }
}
